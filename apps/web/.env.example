# ── Contact form email (server-only — never NEXT_PUBLIC_) ────────────────
# The contact form does not persist anything; it emails each submission via Resend.
# Get the key at https://resend.com → API Keys. The FROM address must belong to a
# domain verified in Resend.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
